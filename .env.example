# EmailJS Configuration
# Get these values from your EmailJS Dashboard (https://dashboard.emailjs.com/)

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Medición
# Ambas son opcionales: sin la variable, esa herramienta simplemente no carga,
# por lo que en desarrollo no se ensucian los datos con visitas de prueba.
# Configúralas en Vercel (Settings > Environment Variables) para producción.

# Píxel de Meta. Administrador de Eventos > Orígenes de datos. Son ~15 dígitos.
VITE_META_PIXEL_ID=

# Google Tag Manager. Es solo el contenedor: no mide nada por sí mismo, las
# etiquetas se configuran dentro de su panel. Empieza con GTM-
VITE_GTM_ID=

# Google Analytics 4. Empieza con G-, se saca de Admin > Flujos de datos > Web.
# Déjalo vacío si GA4 se va a configurar dentro de Tag Manager, para no cargarlo
# dos veces y contar cada visita por duplicado.
VITE_GA4_ID=
