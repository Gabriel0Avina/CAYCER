{
  "outputDirectory": "dist/client",
  "redirects": [
    {
      "source": "/assets/(.*)Temperatura(.*).pdf",
      "destination": "/acreditacion-temperatura.pdf",
      "permanent": true
    },
    {
      "source": "/assets/(.*)Humedad(.*).pdf",
      "destination": "/acreditacion-humedad.pdf",
      "permanent": true
    },
    {
      "source": "/assets/(.*)Especiales(.*).pdf",
      "destination": "/acreditacion-mediciones-especiales.pdf",
      "permanent": true
    }
  ]
}
